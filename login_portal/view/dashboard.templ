package view

import "login_portal/model"

templ Dashboard(user model.User) {
	<h1>Hi! { user.Username }</h1>
	<table>
		<tr>
			<th>Username</th>
			<th>First Name</th>
			<th>Last Name</th>
		</tr>
		<tr>
			<td>{ user.Username }</td>
			<td>{ user.Profile.FirstName }</td>
			<td>{ user.Profile.LastName }</td>
		</tr>
	</table>
}
